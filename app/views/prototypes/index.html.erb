<main class="main">
  <div class="inner">
    <% if user_signed_in? %>
      <%# ログインしているときは以下を表示する %>
      <div class="greeting">
        <%= link_to "こんにちは、#{current_user.name}さん", user_path(current_user), class: :greeting__link%>
      </div>
      <%# // ログインしているときは上記を表示する %>
    <% end %>
    <div class="card__wrapper">
      <%= render partial: "prototype", collection: @prototypes %>
    </div>
  </div>
</main>
